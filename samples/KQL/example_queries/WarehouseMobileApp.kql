// Telemetry for the SCM Warehouse mobile app
database("AppCenterExport-Dynamics-365-for-Finance-and-Operations-Warehousing-Android")

// Warehouse.NextPageRequest (Supply Chain Management version 10.0.31)
customEvents 
| where timestamp >= ago(7d) // adjust as needed
| where customDimensions.eventId == 'WHS000003'
| project timestamp
, activityGraph = customDimensions.activityGraph
, activityId = customDimensions.activityId
, aadTenantId = customDimensions.aadTenantId
, environmentId = customDimensions.environmentId
, elapsedMilliseconds = customDimensions.elapsedMilliseconds
, eventStatus = customDimensions.eventStatus
, mobileDeviceId = customDimensions.mobileDeviceId
, mobileDeviceRequestActivityId = customDimensions.mobileDeviceRequestActivityId
, step = customDimensions.workExecuteStep
, mode = customDimensions.workExecuteMode
, clientCity = client_City
, clientStateOrProvince = client_StateOrProvince
, clientCountryOrRegion = client_CountryOrRegion
| where eventStatus == 'stop'


// Warehouse.ImageRequest (Supply Chain Management version 10.0.31)
customEvents
| where timestamp >= ago(7d) // adjust as needed
| where customDimensions.eventId == 'WHS000004'
| project timestamp
, activityGraph = customDimensions.activityGraph
, activityId = customDimensions.activityId
, aadTenantId = customDimensions.aadTenantId
, environmentId = customDimensions.environmentId
, elapsedMilliseconds = customDimensions.elapsedMilliseconds
, eventStatus = customDimensions.eventStatus 
, mobileDeviceRequestImageDetails = customDimensions.mobileDeviceRequestImageDetails
, mobileDeviceRequestImageIsThumbnail = customDimensions.mobileDeviceRequestImageIsThumbnail
| where eventStatus == 'stop'


// Warehouse.MobileApp.ClientRoundTrip (Warehouse Management mobile app version 2.0.28)
customEvents 
| where timestamp >= ago(7d) // adjust as needed
| where customDimensions.eventId == 'WHS000006'
| project timestamp
, activityGraph = customDimensions.activityGraph
, backendProcessingTime = customDimensions.backendProcessingTime
, batteryLevel = customDimensions.batteryLevel
, batterySession = customDimensions.batterySession
, batteryState = customDimensions.batteryState
, deviceId = customDimensions.deviceId
, isEnergySaverTurnedOn = customDimensions.isEnergySaverTurnedOn
, powerSource = customDimensions.powerSource
, renderingDurationInMilliseconds = customDimensions.renderingDurationInMilliseconds
, roundTripLatencyDurationInMilliseconds = customDimensions.roundTripLatencyDurationInMilliseconds
, clientCity = client_City
, clientStateOrProvince = client_StateOrProvince
, clientCountryOrRegion = client_CountryOrRegion
// Available from Warehouse Management mobile app version 2.1.12
, networkConnectionProfiles = customDimensions.networkConnectionProfiles
, networkAccess = customDimensions.networkAccess
, wifiSignalStrength = customDimensions.wifiSignalStrength
, lastKnownWMSLocation = customDimensions.lastKnownWMSLocation
// Available from Warehouse Management mobile app version 2.1.19
, lastKnownWarehouse = customDimensions.lastKnownWarehouse
, lastKnownDataAreaId = customDimensions.lastKnownDataAreaId
// Available from Warehouse Management mobile app version 4.1.5.0
// Time the worker spent on the page that this request replaced. Reported only
// on the round trip that actually changed the page, so it measures dwell per
// page rather than per request, and is empty for the first page of a session.
, timeSpentLastPage = customDimensions.timeSpentLastPage
// The part of that same interval when the app was backgrounded or the device
// was locked. Kept separate so idle time neither inflates the dwell time nor
// is lost; the two together make up the wall-clock gap.
, idleTimeLastPage = customDimensions.idleTimeLastPage
// Identifier of the worker's server session, recorded on every mobile app
// event. Join on it to follow one session across app and server telemetry.
, serverSessionId = customDimensions.serverSessionId

// Warehouse.MobileApp.FailedServerInvoke (Warehouse Management mobile app version 2.1.14)
customEvents 
| where timestamp >= ago(7d) // adjust as needed
| where customDimensions.eventId == 'WHS000030'
| project timestamp
, activityGraph = customDimensions.activityGraph
, deviceId = customDimensions.deviceId
, serverInvokeErrorMessage = customDimensions.serverInvokeErrorMessage
, requestNextPageTimeInMs = customDimensions.requestNextPageTimeInMilliseconds
, clientCity = client_City
, clientStateOrProvince = client_StateOrProvince
, clientCountryOrRegion = client_CountryOrRegion

// Warehouse.MobileApp.ServiceInvokeException (Warehouse Management mobile app version 2.1.14)
customEvents 
| where timestamp >= ago(7d) // adjust as needed
| where customDimensions.eventId == 'WHS000031'
| project timestamp
, activityGraph = customDimensions.activityGraph
, deviceId = customDimensions.deviceId
, serviceInvokeExceptionCategory = customDimensions.serviceInvokeExceptionCategory
, numberOfRetries = customDimensions.numberOfRetries
, serverInvokeErrorMessage = customDimensions.serverInvokeErrorMessage
, connectionType = customDimensions.connectionType
, clientCity = client_City
, clientStateOrProvince = client_StateOrProvince
, clientCountryOrRegion = client_CountryOrRegion


// Warehouse.MobileApp.OperationFlowTrack (Warehouse Management mobile app version 4.1.5.0)
// One row per unit of warehouse work (a full put-away, a picking run) rather
// than per page or per request. A row is emitted when the server confirms the
// work, and also when the worker gives up on it, so the data is not limited to
// the flows that succeeded.
customEvents
| where timestamp >= ago(7d) // adjust as needed
| where customDimensions.eventId == 'WHS000032'
| project timestamp
, deviceId = customDimensions.deviceId
, serverSessionId = customDimensions.serverSessionId
// 'completed' when the server confirmed the work, otherwise 'abandoned'.
, outcome = customDimensions.outcome
// How the flow ended: 'success', 'cancelled', 'signedOut' or 'sessionLost'.
, status = customDimensions.status
, durationInMilliseconds = customDimensions.durationInMilliseconds
// Requests. Sums travel with the averages because an average cannot be
// re-aggregated: the mean of per-operation means is not the mean over
// operations, so grouping needs the totals.
, requestCount = customDimensions.requestCount
// Transport failures (time-out, 5xx), as opposed to errorMessageCount, which
// counts errors that the server deliberately returned.
, requestFailureCount = customDimensions.requestFailureCount
, totalRequestDurationInMilliseconds = customDimensions.totalRequestDurationInMilliseconds
, averageRequestDurationInMilliseconds = customDimensions.averageRequestDurationInMilliseconds
// Worker actions
, buttonClickCount = customDimensions.buttonClickCount
, submitCount = customDimensions.submitCount
, cancelCount = customDimensions.cancelCount
, detourCount = customDimensions.detourCount
// Dialog boxes that the worker had to open to enter or edit a value. Split by
// kind, because opening the calculator six times and opening the edit dialog
// once describe very different sessions.
, modalOpenCount = customDimensions.modalOpenCount
, totalModalOpenDurationInMilliseconds = customDimensions.totalModalOpenDurationInMilliseconds
, modalCalculatorCount = customDimensions.modalCalculatorCount
, modalTextEditCount = customDimensions.modalTextEditCount
, modalControlEditCount = customDimensions.modalControlEditCount
, modalOtherCount = customDimensions.modalOtherCount
// Pages. Fill time excludes waiting on the server, idle time and time on
// app-local screens, so it reflects the time the worker spent on the page.
, pageCount = customDimensions.pageCount
, totalActiveFillDurationInMilliseconds = customDimensions.totalActiveFillDurationInMilliseconds
, averageActiveFillDurationInMilliseconds = customDimensions.averageActiveFillDurationInMilliseconds
// Where the rest of the elapsed time went
, totalIdleDurationInMilliseconds = customDimensions.totalIdleDurationInMilliseconds
, totalChromeDurationInMilliseconds = customDimensions.totalChromeDurationInMilliseconds
, totalWaitDurationInMilliseconds = customDimensions.totalWaitDurationInMilliseconds
// Messages returned by the server during the flow
, errorMessageCount = customDimensions.errorMessageCount
, warningMessageCount = customDimensions.warningMessageCount
// How the worker entered data
, scanIntentCount = customDimensions.scanIntentCount
, scanKeyboardCount = customDimensions.scanKeyboardCount
, scanBigBlockCount = customDimensions.scanBigBlockCount
, scanCharByCharCount = customDimensions.scanCharByCharCount
, intentProGloveCount = customDimensions.intentProGloveCount
, intentZebraCount = customDimensions.intentZebraCount
, cameraOpenCount = customDimensions.cameraOpenCount
, cameraOpenDurationInMilliseconds = customDimensions.cameraOpenDurationInMilliseconds
// Which flow this was, and whether it ran inside a nested sub-operation
, firstPagePattern = customDimensions.firstPagePattern
, lastPagePattern = customDimensions.lastPagePattern
, wasInDetourSession = customDimensions.wasInDetourSession
, clientCity = client_City
, clientStateOrProvince = client_StateOrProvince
, clientCountryOrRegion = client_CountryOrRegion
